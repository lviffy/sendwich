{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/styles.css", "dest": "/public/styles.css" },
    { "src": "/style.css", "dest": "/public/style.css" },
    { "src": "/script.js", "dest": "/public/script.js" },
    { "src": "/sender.js", "dest": "/public/sender.js" },
    { "src": "/receiver.js", "dest": "/public/receiver.js" },
    { "src": "/sender", "dest": "/public/sender.html" },
    { "src": "/receiver", "dest": "/public/receiver.html" },
    { "src": "/about", "dest": "/public/about.html" },
    { "src": "/(.*)", "dest": "index.js" }
  ]
}
